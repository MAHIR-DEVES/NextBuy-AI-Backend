model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?  @unique
  avatar    String?

  role      Role     @default(CUSTOMER)

  // Status
  status    STATUS   @default(ACTIVE)

  // Address (optional but important for ecommerce)
  address   String?
  city      String?
  country   String?

  // Auth tracking
  lastLogin DateTime?
  emailVerified Boolean @default(false)
  provider String? // google, email

  // Relations (future use)
  orders    Order[]
  carts     Cart[]
  wishlist Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}